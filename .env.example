# Copy to .env and fill in. Never commit .env.

# --- Backend ---
TOMTOM_API_KEY=
DJANGO_SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# console (readable, local) or json (Docker, Render)
LOG_FORMAT=console
LOG_LEVEL=INFO

# --- Frontend (VITE_ variables are visible in the browser; never put secrets here) ---
VITE_API_BASE_URL=http://localhost:8000
# A separate TomTom key with only Map Display enabled, restricted to your site's domain.
VITE_TOMTOM_MAP_KEY=
